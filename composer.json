{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "field-vn/filament-themes",
    "description": "Design-system themes for Filament 5 panels (Tabler, shadcn/ui, Ant Design): a drop-in plugin, no build step.",
    "keywords": ["filament", "filament-plugin", "filament-theme", "tabler", "shadcn", "ant-design", "laravel"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "codeat3/blade-ant-design-icons": "^1.10",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.24",
        "mallardduck/blade-lucide-icons": "^2.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "secondnetwork/blade-tabler-icons": "^3.49"
    },
    "suggest": {
        "secondnetwork/blade-tabler-icons": "Tabler Icons, for ->icons() with Preset::Tabler",
        "mallardduck/blade-lucide-icons": "Lucide, for ->icons() with Preset::Shadcn",
        "codeat3/blade-ant-design-icons": "Ant Design Icons, for ->icons() with Preset::Antd"
    },
    "autoload": {
        "psr-4": {
            "FieldVn\\FilamentThemes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FieldVn\\FilamentThemes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "FieldVn\\FilamentThemes\\FilamentThemesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
